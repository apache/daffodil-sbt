# this repo's scriptedLaunchOpts sets -Xss4m for the sbt JVM running this script. Running
# packageDaffodilBin writes the equivalent forked "java ..." command line to its export stream,
# so we can check that the actual command used to build the saved parser inherited that same
# -Xss

> packageDaffodilBin
$ exists target/test-0.1-daffodil410.bin
$ exec grep -q -- -Xss4m target/streams/compile/packageDaffodilBin/_global/streams/export

> clean

# a project-specified -Xss should take precedence over the inherited one
> set packageDaffodilBin / javaOptions += "-Xss7m"

> packageDaffodilBin
$ exists target/test-0.1-daffodil410.bin
$ exec grep -q -- -Xss7m target/streams/compile/packageDaffodilBin/_global/streams/export
